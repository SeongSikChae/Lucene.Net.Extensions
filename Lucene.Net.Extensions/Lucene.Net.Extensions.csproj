<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace />
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<IsPackable>false</IsPackable>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Authors>SeongSikChae</Authors>
		<PackageProjectUrl>https://github.com/SeongSikChae/Lucene.Net.Extensions.git</PackageProjectUrl>
		<RepositoryUrl>https://github.com/SeongSikChae/Lucene.Net.Extensions.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Version>4.8.0-beta00018-7</Version>
		<PackageId>Biz.Bizadm.Lucene.Net.Extensions</PackageId>
		<AssemblyName>Biz.Bizadm.$(MSBuildProjectName)</AssemblyName>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<Description>.NET 각 데이터 타입을 기반으로 인덱싱하고 검색 할 수 있게 기능 확장</Description>
		<NoWarn>$(NoWarn);IDE0090;IDE0290</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Lucene.Net.QueryParser" Version="4.8.0-beta00018" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Biz.Bizadm.Lucene.Net.ExtensionsTests" />
		<InternalsVisibleTo Include="Biz.Bizadm.Lucene.Net.Extensions.Runtime" />
	</ItemGroup>

</Project>
